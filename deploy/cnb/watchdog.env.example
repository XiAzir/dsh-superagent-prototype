# CNB workspace watchdog configuration. Keep PAT contents in the referenced
# root-owned 0600 files; this template contains paths and nonsecret settings.
CNB_REPO=XiAzir/dsh-superagent
CNB_BRANCH=linux
FIXED_URL=https://<fixed-domain>/superagent-runtime/health
FALLBACK_TOKEN=/root/.cnb/superagent/watchdog-token
FALLBACK_LIST_TOKEN=/root/.cnb/superagent/watchdog-list-token
CNB_WATCHDOG_LOG=/var/log/cnb-watchdog-superagent.log
CNB_WATCHDOG_STATE=/tmp/cnb-watchdog-superagent-fails
CNB_THRESH_RECYCLE=2
CNB_THRESH_ALERT=4
RECOVER_COOLDOWN=1800
